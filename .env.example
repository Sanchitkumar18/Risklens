# ── RiskLens configuration ──────────────────────────────────
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# NOTE: never commit a real `.env`. Secrets stay out of git (.gitignore).

# ── Application ─────────────────────────────────────────────
APP_NAME=RiskLens
APP_ENV=development            # development | production | test
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                 # true = structured JSON logs (prod), false = human-readable

# ── Database ────────────────────────────────────────────────
# Local (host) default. Inside docker-compose this is overridden to host `postgres`.
DATABASE_URL=postgresql+psycopg2://risklens:risklens@localhost:5432/risklens

# ── LLM / GenAI ─────────────────────────────────────────────
# LLM_PROVIDER=mock lets the whole app run WITHOUT an API key (deterministic assistant).
# Set to `openai` (or any OpenAI-compatible endpoint) to use a real model.
LLM_PROVIDER=mock              # mock | openai
OPENAI_API_KEY=                # leave blank when LLM_PROVIDER=mock
OPENAI_BASE_URL=               # optional: OpenAI-compatible endpoint (e.g. local server)
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0

# ── Risk engine defaults ────────────────────────────────────
DEFAULT_CONFIDENCE_LEVEL=0.95
TRADING_DAYS_PER_YEAR=252
MIN_HISTORY_OBSERVATIONS=2

# ── Caching ─────────────────────────────────────────────────
PRICE_CACHE_TTL_SECONDS=300
